<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Starling v2 scene IR. The non-replaceable core: surface graph, render scene,
    resource table, hit regions, accessibility tree, text handles, and provenance.
    Pure managed, no native, no GPU, no ImageSharp. See browser-plan/v2/.

    v2 targets .NET 11 with the C# preview language version so it can use new
    features (for example C# 15 union types) for correctness/exhaustiveness
    modeling, per the performance policy in AGENTS.md. These override the
    repo-wide net10.0 / C# 14 defaults in Directory.Build.props.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsPackable>false</IsPackable>
    <!-- The UnionAttribute/IUnion polyfill in UnionSupport.cs conflicts with the
         runtime copy once a .NET 11 preview ships it (CS0436, source wins). Suppress
         that so the polyfill is safe whether or not the runtime provides the types. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- .NET 11 prunes Microsoft.Extensions.Logging.Abstractions into the shared
         framework, so the reference inherited from the repo-root Directory.Build.props
         trips NU1510 under warnings-as-errors. v2 does not use logging, so drop it. -->
    <PackageReference Remove="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
